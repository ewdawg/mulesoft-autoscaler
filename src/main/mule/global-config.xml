<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <!-- All tunable values live in config.properties. Secrets should be supplied
         at deploy time as system properties rather than committed to the file. -->
    <configuration-properties file="config.properties" doc:name="Configuration properties"/>

    <!-- Inbound: receives the monitoring alert webhook. -->
    <http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config">
        <http:listener-connection host="0.0.0.0" port="${http.port}"/>
    </http:listener-config>

    <!-- Outbound: Anypoint Platform control-plane APIs (token + Application Manager). -->
    <http:request-config name="Anypoint_Request_config" doc:name="Anypoint Platform request config">
        <http:request-connection protocol="HTTPS" host="${anypoint.host}" port="443"/>
    </http:request-config>

    <!-- Debounce store. An entry keyed by deployment id is written after every
         scaling action and expires after scale.cooldown.seconds, which is what
         stops a repeatedly-firing alert from ratcheting replicas.

         Persistent: this app is edge-triggered and has no way to observe load
         directly, so it cannot reconstruct this state after a restart. Losing it
         would let a restart bypass the debounce entirely. -->
    <os:object-store name="Cooldown_Store"
                     doc:name="Cooldown store"
                     persistent="true"
                     maxEntries="1000"
                     entryTtl="${scale.cooldown.seconds}"
                     entryTtlUnit="SECONDS"
                     expirationInterval="60"
                     expirationIntervalUnit="SECONDS"/>

    <!-- Deployments this app has scaled, and when it last acted on each. Drives
         the decay flow. No TTL: an entry lives until the deployment is back at
         scale.min.replicas, at which point there is nothing left to decay and the
         entry is removed. -->
    <os:object-store name="Managed_Deployments"
                     doc:name="Managed deployments store"
                     persistent="true"
                     maxEntries="1000"/>

    <!-- Diagnostic capture of raw inbound requests, used to verify what an alert
         source actually posts. Written only when capture.enabled is true.

         Persistent because the point is to survive the gap between an alert
         firing and someone reading the result, which may span a restart. Small
         and TTL'd: this holds unvalidated request bodies from an endpoint that
         is deliberately unauthenticated, so it is bounded in both size and age
         rather than left to grow. -->
    <os:object-store name="Alert_Captures"
                     doc:name="Alert captures store"
                     persistent="true"
                     maxEntries="25"
                     entryTtl="604800"
                     entryTtlUnit="SECONDS"
                     expirationInterval="3600"
                     expirationIntervalUnit="SECONDS"/>
</mule>
