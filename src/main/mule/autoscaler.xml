<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <!--
      Entry point. Receives an Anypoint Monitoring alert webhook and, subject to
      the shared secret, the configured thresholds, the replica bounds and the
      cooldown window, adjusts the target deployment's replica count by one step.
    -->
    <flow name="autoscale-webhook-flow">
        <http:listener config-ref="HTTP_Listener_config"
                       path="/autoscale/webhook"
                       allowedMethods="POST"
                       doc:name="Receive alert webhook">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:error-response>
        </http:listener>

        <flow-ref name="verify-webhook-secret" doc:name="Verify shared secret"/>
        <flow-ref name="normalize-alert" doc:name="Normalize alert"/>

        <ee:transform doc:name="Decide direction">
            <ee:variables>
                <ee:set-variable variableName="direction"><![CDATA[%dw 2.0
output application/java
var v = vars.alert.currentValue
---
if (v >= (p('scale.up.threshold') as Number)) "UP"
else if (v <= (p('scale.down.threshold') as Number)) "DOWN"
else "NONE"
]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <choice doc:name="Scaling direction">
            <when expression="#[vars.direction == 'NONE']">
                <logger level="INFO" doc:name="Log within band"
                        message="#['No action for ' ++ vars.alert.applicationName ++ ': ' ++ (vars.alert.currentValue as String) ++ ' is between the scale-down and scale-up thresholds.']"/>
                <flow-ref name="build-skipped-response" doc:name="Respond within band"/>
            </when>
            <otherwise>
                <os:contains doc:name="Check cooldown"
                             key="#[vars.alert.deploymentId]"
                             objectStore="Cooldown_Store"
                             target="inCooldown"/>
                <choice doc:name="Cooldown active?">
                    <when expression="#[vars.inCooldown]">
                        <logger level="INFO" doc:name="Log cooldown"
                                message="#['Suppressed ' ++ vars.direction ++ ' for ' ++ vars.alert.applicationName ++ ': still inside the cooldown window.']"/>
                        <flow-ref name="build-skipped-response" doc:name="Respond cooldown"/>
                    </when>
                    <otherwise>
                        <flow-ref name="apply-scaling" doc:name="Apply scaling"/>
                    </otherwise>
                </choice>
            </otherwise>
        </choice>

        <error-handler>
            <on-error-continue type="AUTOSCALER:UNAUTHORIZED" logException="false" doc:name="Unauthorized">
                <logger level="WARN" doc:name="Log rejected call"
                        message="Rejected webhook call: missing or invalid X-Autoscaler-Secret header."/>
                <set-variable variableName="httpStatus" value="#[401]" doc:name="Set 401"/>
                <ee:transform doc:name="Unauthorized body">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ status: "unauthorized", message: "Missing or invalid webhook secret." }
]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </on-error-continue>

            <on-error-continue type="AUTOSCALER:BAD_REQUEST" logException="false" doc:name="Bad request">
                <logger level="WARN" doc:name="Log malformed alert"
                        message="#['Rejected webhook call: ' ++ (error.description default 'malformed alert payload')]"/>
                <set-variable variableName="httpStatus" value="#[400]" doc:name="Set 400"/>
                <ee:transform doc:name="Bad request body">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "bad_request",
    message: error.description default "Malformed alert payload."
}
]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </on-error-continue>

            <on-error-continue type="ANY" logException="true" doc:name="Unexpected failure">
                <logger level="ERROR" doc:name="Log failure"
                        message="#['Autoscaling failed: ' ++ (error.description default 'unknown error')]"/>
                <set-variable variableName="httpStatus" value="#[500]" doc:name="Set 500"/>
                <ee:transform doc:name="Error body">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "error",
    message: "Failed to process alert.",
    detail: error.description default "unknown error"
}
]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </on-error-continue>
        </error-handler>
    </flow>

    <!--
      Rejects any call that does not present the shared secret. This is the only
      thing standing between a publicly reachable endpoint and a stranger being
      able to change your replica count, so it runs before anything else.
    -->
    <sub-flow name="verify-webhook-secret">
        <choice doc:name="Secret valid?">
            <when expression="#[(attributes.headers['x-autoscaler-secret'] default '') != p('webhook.secret')]">
                <raise-error type="AUTOSCALER:UNAUTHORIZED"
                             description="Missing or invalid X-Autoscaler-Secret header"
                             doc:name="Reject call"/>
            </when>
        </choice>
    </sub-flow>

    <!--
      SINGLE POINT OF TRUTH for the inbound webhook contract.

      NOTE: the exact Anypoint Monitoring webhook body has not been verified
      against a live alert. Each field falls back through the shapes previously
      assumed by this project so that correcting the contract means editing this
      one transform and nothing else. Confirm against a captured payload before
      pointing this at production.
    -->
    <sub-flow name="normalize-alert">
        <!-- Capture the body before interpreting it. If the real alert does carry
             the shared secret and so reaches this path, this is where its shape
             gets recorded; the dedicated capture endpoint below covers the case
             where it cannot send the header at all. Reading the payload here is
             safe because Mule's repeatable streaming lets the transform below
             read it again. -->
        <choice doc:name="Capture raw alert?">
            <when expression="#[p('capture.enabled') == 'true']">
                <flow-ref name="capture-request" doc:name="Capture raw alert"/>
            </when>
        </choice>

        <ee:transform doc:name="Normalize alert">
            <ee:variables>
                <ee:set-variable variableName="alert"><![CDATA[%dw 2.0
output application/java
var a = payload.alert default payload.event default payload
var resource = a.resource default {}
---
{
    alertId:         (a.id default a.alertId default "unknown") as String,
    applicationName: (resource.name default a.appName default a.applicationName default "unknown") as String,
    deploymentId:    (resource.id default a.deploymentId default a.appId default "") as String,
    organizationId:  (a.organization.id default resource.organizationId default p('anypoint.org.id') default "") as String,
    environmentId:   (resource.environment.id default a.environmentId default p('anypoint.env.id') default "") as String,
    metric:          (a.metric default "cpu") as String,
    currentValue:    (a.currentValue default a.value default 0) as Number
}
]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <choice doc:name="Deployment id present?">
            <when expression="#[vars.alert.deploymentId == '']">
                <raise-error type="AUTOSCALER:BAD_REQUEST"
                             description="Alert payload did not contain a deployment id"
                             doc:name="Reject malformed alert"/>
            </when>
        </choice>

        <logger level="INFO" doc:name="Log alert"
                message="#['Alert ' ++ vars.alert.alertId ++ ' for ' ++ vars.alert.applicationName ++ ': ' ++ vars.alert.metric ++ '=' ++ (vars.alert.currentValue as String)]"/>
    </sub-flow>

    <!--
      Reads the deployment, computes a bounded target replica count, and applies
      it only when it actually differs from the current value.
    -->
    <sub-flow name="apply-scaling">
        <flow-ref name="anypoint-get-token" doc:name="Get access token"/>
        <flow-ref name="anypoint-get-deployment" doc:name="Get current deployment"/>

        <ee:transform doc:name="Compute target replicas">
            <ee:variables>
                <ee:set-variable variableName="currentReplicas"><![CDATA[%dw 2.0
output application/java
---
(vars.deployment.target.replicas default p('scale.min.replicas')) as Number
]]></ee:set-variable>
                <ee:set-variable variableName="desiredReplicas"><![CDATA[%dw 2.0
output application/java
var step    = p('scale.step') as Number
var minR    = p('scale.min.replicas') as Number
var maxR    = p('scale.max.replicas') as Number
var current = (vars.deployment.target.replicas default p('scale.min.replicas')) as Number
var raw     = if (vars.direction == "UP") current + step else current - step
---
max([minR, min([maxR, raw])])
]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <choice doc:name="Replica count changing?">
            <when expression="#[vars.desiredReplicas != vars.currentReplicas]">
                <flow-ref name="anypoint-patch-replicas" doc:name="Patch replica count"/>

                <os:store doc:name="Start cooldown"
                          key="#[vars.alert.deploymentId]"
                          objectStore="Cooldown_Store">
                    <os:value>#[now() as String]</os:value>
                </os:store>

                <!-- Remember enough about this deployment for the decay flow to
                     act on it later without needing another alert. -->
                <os:store doc:name="Track for decay"
                          key="#[vars.alert.deploymentId]"
                          objectStore="Managed_Deployments">
                    <os:value><![CDATA[#[write({
    applicationName: vars.alert.applicationName,
    organizationId: vars.alert.organizationId,
    environmentId: vars.alert.environmentId,
    replicas: vars.desiredReplicas,
    lastActionAt: now() as Number {unit: "seconds"}
}, 'application/json') as String]]]></os:value>
                </os:store>

                <logger level="INFO" doc:name="Log scaled"
                        message="#['Scaled ' ++ vars.alert.applicationName ++ ' ' ++ vars.direction ++ ' from ' ++ (vars.currentReplicas as String) ++ ' to ' ++ (vars.desiredReplicas as String) ++ ' replicas.']"/>

                <ee:transform doc:name="Success body">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "scaled",
    application: vars.alert.applicationName,
    direction: vars.direction,
    previousReplicas: vars.currentReplicas,
    replicas: vars.desiredReplicas
}
]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </when>
            <otherwise>
                <logger level="INFO" doc:name="Log at bound"
                        message="#['No action for ' ++ vars.alert.applicationName ++ ': already at the replica bound (' ++ (vars.currentReplicas as String) ++ ').']"/>
                <flow-ref name="build-skipped-response" doc:name="Respond at bound"/>
            </otherwise>
        </choice>
    </sub-flow>

    <!--
      Level-triggered safety net.

      Everything above is edge-triggered: it only acts when an alert arrives. That
      makes the expensive failure mode a silent one — if a scale-down alert is
      never configured, is dropped, or the webhook path breaks after a scale-up,
      the deployment stays at an elevated replica count indefinitely and quietly
      bills for it.

      This flow converges on elapsed time rather than on load, which matters
      because without the top-tier subscription there is no metrics API to poll.
      A deployment that has not been scaled for decay.idle.seconds loses one step,
      repeatedly, until it is back at scale.min.replicas. Any alert arriving in the
      meantime resets the clock, so a genuinely busy application is never decayed.
    -->
    <flow name="autoscale-decay-flow">
        <scheduler doc:name="Decay scheduler">
            <scheduling-strategy>
                <fixed-frequency frequency="${decay.interval.seconds}"
                                 startDelay="${decay.start.delay.seconds}"
                                 timeUnit="SECONDS"/>
            </scheduling-strategy>
        </scheduler>

        <choice doc:name="Decay enabled?">
            <when expression="#[p('decay.enabled') == 'true']">
                <os:retrieve-all-keys objectStore="Managed_Deployments"
                                      target="managedKeys"
                                      doc:name="List managed deployments"/>

                <foreach collection="#[vars.managedKeys]" doc:name="For each managed deployment">
                    <set-variable variableName="decayKey" value="#[payload]" doc:name="Deployment id"/>
                    <try doc:name="Isolate per-deployment failures">
                        <flow-ref name="decay-one-deployment" doc:name="decay-one-deployment"/>
                        <error-handler>
                            <on-error-continue type="ANY" logException="true" doc:name="Continue with the rest">
                                <logger level="ERROR" doc:name="Log decay failure"
                                        message="#['Decay failed for deployment ' ++ (vars.decayKey default 'unknown') ++ ': ' ++ (error.description default 'unknown error')]"/>
                            </on-error-continue>
                        </error-handler>
                    </try>
                </foreach>
            </when>
        </choice>
    </flow>

    <sub-flow name="decay-one-deployment">
        <os:retrieve key="#[vars.decayKey]"
                     objectStore="Managed_Deployments"
                     target="managedRecord"
                     doc:name="Read decay record">
            <os:default-value>#[null]</os:default-value>
        </os:retrieve>

        <os:contains key="#[vars.decayKey]"
                     objectStore="Cooldown_Store"
                     target="inCooldown"
                     doc:name="Check cooldown"/>

        <ee:transform doc:name="Evaluate idleness">
            <ee:variables>
                <ee:set-variable variableName="record"><![CDATA[%dw 2.0
output application/java
---
if (vars.managedRecord == null) null
else read(vars.managedRecord, 'application/json')
]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <ee:transform doc:name="Compute idle seconds">
            <ee:variables>
                <ee:set-variable variableName="idleSeconds"><![CDATA[%dw 2.0
output application/java
---
if (vars.record == null) 0
else (now() as Number {unit: "seconds"}) - (vars.record.lastActionAt as Number)
]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <choice doc:name="Idle long enough?">
            <when expression="#[vars.record != null and (not vars.inCooldown) and vars.idleSeconds >= (p('decay.idle.seconds') as Number)]">
                <ee:transform doc:name="Synthesize decay action">
                    <ee:variables>
                        <ee:set-variable variableName="direction">#["DOWN"]</ee:set-variable>
                        <ee:set-variable variableName="alert"><![CDATA[%dw 2.0
output application/java
---
{
    alertId: "decay",
    applicationName: vars.record.applicationName default "unknown",
    deploymentId: vars.decayKey,
    organizationId: vars.record.organizationId default "",
    environmentId: vars.record.environmentId default "",
    metric: "idle",
    currentValue: 0
}
]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>

                <logger level="INFO" doc:name="Log decay"
                        message="#['Decaying ' ++ (vars.record.applicationName default vars.decayKey) ++ ': idle for ' ++ (vars.idleSeconds as String) ++ 's.']"/>

                <flow-ref name="apply-scaling" doc:name="apply-scaling"/>

                <choice doc:name="Back at minimum?">
                    <when expression="#[vars.desiredReplicas &lt;= (p('scale.min.replicas') as Number)]">
                        <os:remove key="#[vars.decayKey]"
                                   objectStore="Managed_Deployments"
                                   doc:name="Stop tracking"/>
                        <logger level="INFO" doc:name="Log tracking stopped"
                                message="#['Deployment ' ++ vars.decayKey ++ ' is back at the minimum replica count; no longer tracked for decay.']"/>
                    </when>
                </choice>
            </when>
        </choice>
    </sub-flow>

    <sub-flow name="anypoint-get-token">
        <http:request method="POST"
                      config-ref="Anypoint_Request_config"
                      path="/accounts/api/v2/oauth2/token"
                      doc:name="Request access token">
            <http:body><![CDATA[#[output application/x-www-form-urlencoded
---
{
    grant_type: "client_credentials",
    client_id: p('anypoint.client.id'),
    client_secret: p('anypoint.client.secret')
}
]]]></http:body>
        </http:request>
        <set-variable variableName="accessToken" value="#[payload.access_token]" doc:name="Store access token"/>
    </sub-flow>

    <sub-flow name="anypoint-get-deployment">
        <http:request method="GET"
                      config-ref="Anypoint_Request_config"
                      path="/amc/application-manager/api/v2/organizations/{orgId}/environments/{envId}/deployments/{deploymentId}"
                      doc:name="Get deployment">
            <http:headers><![CDATA[#[output application/java
---
{
    "Authorization": "Bearer " ++ vars.accessToken
}
]]]></http:headers>
            <http:uri-params><![CDATA[#[output application/java
---
{
    orgId: vars.alert.organizationId,
    envId: vars.alert.environmentId,
    deploymentId: vars.alert.deploymentId
}
]]]></http:uri-params>
        </http:request>
        <set-variable variableName="deployment" value="#[payload]" doc:name="Store deployment"/>
    </sub-flow>

    <!--
      PATCH with only the field being changed. The previous implementation sent a
      full deployment body, which risked overwriting cpu/memory and region with
      whatever happened to be hardcoded or stale.
    -->
    <sub-flow name="anypoint-patch-replicas">
        <http:request method="PATCH"
                      config-ref="Anypoint_Request_config"
                      path="/amc/application-manager/api/v2/organizations/{orgId}/environments/{envId}/deployments/{deploymentId}"
                      doc:name="Patch replicas">
            <http:body><![CDATA[#[output application/json
---
{
    target: {
        replicas: vars.desiredReplicas
    }
}
]]]></http:body>
            <http:headers><![CDATA[#[output application/java
---
{
    "Authorization": "Bearer " ++ vars.accessToken,
    "Content-Type": "application/json"
}
]]]></http:headers>
            <http:uri-params><![CDATA[#[output application/java
---
{
    orgId: vars.alert.organizationId,
    envId: vars.alert.environmentId,
    deploymentId: vars.alert.deploymentId
}
]]]></http:uri-params>
        </http:request>
    </sub-flow>

    <sub-flow name="build-skipped-response">
        <ee:transform doc:name="Skipped body">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "skipped",
    application: vars.alert.applicationName,
    direction: vars.direction,
    currentValue: vars.alert.currentValue
}
]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </sub-flow>

    <!-- ==================== Diagnostic capture ====================

      The webhook contract is the one part of this application that could not be
      verified by testing what it sends, because it is defined by what something
      else sends it. These flows exist to observe that, and are inert unless
      capture.enabled is true.

      Why a separate endpoint rather than just logging in normalize-alert:
      verify-webhook-secret runs first, so if the alert source cannot attach a
      custom header, a real alert is rejected with 401 and its body is never
      seen, which is exactly the payload we need. This endpoint checks no
      header. What protects it instead is capture.path, which carries a random
      segment: an alert action always lets you set the URL, but may not let you
      set headers, so the path is the only secret that can be relied on here.
    -->

    <!--
      Records one raw request. Deliberately total: it captures the body without
      interpreting it, so a form-encoded, XML or malformed body is preserved
      rather than lost to a parse error. The headers matter as much as the body,
      since they answer whether a custom header survives the trip.
    -->
    <sub-flow name="capture-request">
        <!-- octet-stream so nothing tries to parse the body on the way in. -->
        <set-variable variableName="rawBody"
                      value="#[payload]"
                      mimeType="application/octet-stream"
                      doc:name="Raw body"/>

        <ee:transform doc:name="Build capture record">
            <ee:variables>
                <ee:set-variable variableName="captureRecord"><![CDATA[%dw 2.0
output application/java
---
{
    receivedAt:  now() as String,
    method:      attributes.method default "unknown",
    requestPath: attributes.requestPath default "unknown",
    queryString: attributes.queryString default "",
    headers:     attributes.headers default {},
    body:        (vars.rawBody as String) default ""
}
]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <os:store doc:name="Store capture"
                  key="#[now() as String {format: 'yyyyMMdd-HHmmss.SSS'}]"
                  objectStore="Alert_Captures">
            <os:value>#[write(vars.captureRecord, 'application/json') as String]</os:value>
        </os:store>

        <!-- Marker string so the record can be found by grepping downloaded logs,
             which is the fallback when the read-back endpoint is unreachable. -->
        <logger level="INFO" doc:name="Log capture"
                message="#['AUTOSCALER-CAPTURE ' ++ (write(vars.captureRecord, 'application/json') as String)]"/>
    </sub-flow>

    <!--
      Unauthenticated by design (see above). Always answers 200, including when
      capture itself fails: an alert action that receives errors may be disabled
      upstream, and losing the alert source would defeat the purpose.
    -->
    <flow name="autoscale-capture-flow">
        <http:listener config-ref="HTTP_Listener_config"
                       path="${capture.path}"
                       doc:name="Receive raw capture">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:response>
            <http:error-response statusCode="200">
                <http:body><![CDATA[#[%dw 2.0
output application/json
---
{ status: "captured" }]]]></http:body>
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:error-response>
        </http:listener>

        <choice doc:name="Capture enabled?">
            <when expression="#[p('capture.enabled') == 'true']">
                <flow-ref name="capture-request" doc:name="Capture request"/>
                <ee:transform doc:name="Captured body">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ status: "captured" }
]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </when>
            <otherwise>
                <set-variable variableName="httpStatus" value="#[404]" doc:name="Set 404"/>
                <ee:transform doc:name="Disabled body">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ status: "disabled" }
]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </otherwise>
        </choice>

        <error-handler>
            <!-- Never fail closed: report success to the caller even if the
                 capture could not be written, and leave the reason in the log. -->
            <on-error-continue type="ANY" logException="true" doc:name="Capture failure is not the caller's problem">
                <logger level="ERROR" doc:name="Log capture failure"
                        message="#['Failed to capture request: ' ++ (error.description default 'unknown error')]"/>
                <set-variable variableName="httpStatus" value="#[200]" doc:name="Set 200"/>
                <ee:transform doc:name="Captured body despite failure">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ status: "captured" }
]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </on-error-continue>
        </error-handler>
    </flow>

    <!--
      Reads back what was captured. This is the primary retrieval path; scraping
      downloaded logs for the AUTOSCALER-CAPTURE marker is the fallback. Requires
      the shared secret, unlike the capture endpoint itself, because here we are
      handing data out rather than taking it in.
    -->
    <flow name="autoscale-captures-read-flow">
        <http:listener config-ref="HTTP_Listener_config"
                       path="/autoscale/captures"
                       allowedMethods="GET"
                       doc:name="Read captures">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:error-response>
        </http:listener>

        <flow-ref name="verify-webhook-secret" doc:name="Verify shared secret"/>

        <choice doc:name="Capture enabled?">
            <when expression="#[p('capture.enabled') == 'true']">
                <os:retrieve-all-keys objectStore="Alert_Captures"
                                      target="captureKeys"
                                      doc:name="List captures"/>

                <set-variable variableName="captures" value="#[[]]" doc:name="Init capture list"/>

                <foreach collection="#[vars.captureKeys default []]" doc:name="For each capture">
                    <os:retrieve key="#[payload]"
                                 objectStore="Alert_Captures"
                                 target="oneCapture"
                                 doc:name="Read one capture">
                        <os:default-value>#[null]</os:default-value>
                    </os:retrieve>
                    <ee:transform doc:name="Append capture">
                        <ee:variables>
                            <ee:set-variable variableName="captures"><![CDATA[%dw 2.0
output application/java
---
if (vars.oneCapture == null) vars.captures
else (vars.captures << read(vars.oneCapture, 'application/json'))
]]></ee:set-variable>
                        </ee:variables>
                    </ee:transform>
                </foreach>

                <ee:transform doc:name="Captures body">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    count: sizeOf(vars.captures default []),
    captures: vars.captures default []
}
]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </when>
            <otherwise>
                <set-variable variableName="httpStatus" value="#[404]" doc:name="Set 404"/>
                <ee:transform doc:name="Disabled body">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ status: "disabled" }
]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </otherwise>
        </choice>

        <error-handler>
            <on-error-continue type="AUTOSCALER:UNAUTHORIZED" logException="false" doc:name="Unauthorized">
                <logger level="WARN" doc:name="Log rejected read"
                        message="Rejected captures read: missing or invalid X-Autoscaler-Secret header."/>
                <set-variable variableName="httpStatus" value="#[401]" doc:name="Set 401"/>
                <ee:transform doc:name="Unauthorized body">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ status: "unauthorized", message: "Missing or invalid webhook secret." }
]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </on-error-continue>
        </error-handler>
    </flow>
</mule>
