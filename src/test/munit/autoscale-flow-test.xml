<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <munit:config name="autoscale-flow-test.xml">
        <munit:parameterizations/>
    </munit:config>

    <!--
      The flows under test are driven through their sub-flows rather than the HTTP
      listener, so each test sets vars.alert directly where the listener would
      normally have produced it. Mocks are keyed on doc:name: MUnit matches a
      processor's *configured* attributes, not runtime message attributes, which
      is why keying on the HTTP method (as the previous suite did) cannot work.
    -->

    <!-- Both stores are persistent, so they survive not just between tests but
         between builds. Clearing them here is what keeps the suite deterministic. -->
    <munit:before-test name="clear-stores" description="Empty both object stores between tests">
        <os:clear objectStore="Cooldown_Store" doc:name="Clear cooldown store"/>
        <os:clear objectStore="Managed_Deployments" doc:name="Clear managed deployments"/>
    </munit:before-test>

    <!-- ==================== apply-scaling ==================== -->

    <munit:test name="scales-up-by-one-step"
                description="A deployment below the maximum is patched to one more replica">
        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock token" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Request access token" attributeName="doc:name"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{ access_token: 'test-token' }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <munit-tools:mock-when doc:name="Mock get deployment" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Get deployment" attributeName="doc:name"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{ target: { replicas: 2 } }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <munit-tools:mock-when doc:name="Mock patch" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Patch replicas" attributeName="doc:name"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <set-variable variableName="direction" value="UP" doc:name="Direction UP"/>
            <set-variable variableName="alert" doc:name="Alert"
                          value="#[{ alertId: 'a1', applicationName: 'test-app', deploymentId: 'dep-1', organizationId: 'org-1', environmentId: 'env-1', metric: 'cpu', currentValue: 85 }]"/>
        </munit:behavior>

        <munit:execution>
            <flow-ref name="apply-scaling" doc:name="apply-scaling"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that expression="#[vars.currentReplicas]"
                                     is="#[MunitTools::equalTo(2)]"
                                     message="Current replicas should be read from target.replicas"/>
            <munit-tools:assert-that expression="#[vars.desiredReplicas]"
                                     is="#[MunitTools::equalTo(3)]"
                                     message="Should scale up by one step"/>
            <munit-tools:verify-call doc:name="Verify patch called" processor="http:request" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Patch replicas" attributeName="doc:name"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

