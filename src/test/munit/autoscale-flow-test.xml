    <!-- ==================== normalize-alert ==================== -->

    <munit:test name="normalizes-nested-alert-shape"
                description="An alert wrapped in payload.alert is mapped onto the internal shape">
        <munit:behavior>
            <munit:set-event>
                <munit:payload value="#[{ alert: { id: 'alert-9', metric: 'cpu', currentValue: 88, resource: { id: 'dep-9', name: 'billing-api', environment: { id: 'env-9' } }, organization: { id: 'org-9' } } }]"/>
            </munit:set-event>
        </munit:behavior>

        <munit:execution>
            <flow-ref name="normalize-alert" doc:name="normalize-alert"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that expression="#[vars.alert.deploymentId]" is="#[MunitTools::equalTo('dep-9')]" message="deploymentId"/>
            <munit-tools:assert-that expression="#[vars.alert.applicationName]" is="#[MunitTools::equalTo('billing-api')]" message="applicationName"/>
            <munit-tools:assert-that expression="#[vars.alert.organizationId]" is="#[MunitTools::equalTo('org-9')]" message="organizationId"/>
            <munit-tools:assert-that expression="#[vars.alert.environmentId]" is="#[MunitTools::equalTo('env-9')]" message="environmentId"/>
            <munit-tools:assert-that expression="#[vars.alert.currentValue]" is="#[MunitTools::equalTo(88)]" message="currentValue"/>
        </munit:validation>
    </munit:test>

    <munit:test name="normalizes-flat-event-shape"
                description="The legacy payload.event shape still maps onto the internal shape">
        <munit:behavior>
