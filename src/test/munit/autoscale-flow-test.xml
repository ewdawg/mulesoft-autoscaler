    <!-- ==================== end-to-end through autoscale-webhook-flow ==================== -->

    <munit:test name="e2e-high-cpu-scales-up"
                description="A well-formed authenticated alert above the threshold scales the deployment">
        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock token" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Request access token" attributeName="doc:name"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{ access_token: 'test-token' }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="Mock get deployment" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Get deployment" attributeName="doc:name"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{ target: { replicas: 2 } }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="Mock patch" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Patch replicas" attributeName="doc:name"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <munit:set-event>
                <munit:payload value="#[{ alert: { id: 'e2e-1', metric: 'cpu', currentValue: 92, resource: { id: 'dep-e2e-1', name: 'orders-api', environment: { id: 'env-1' } }, organization: { id: 'org-1' } } }]"/>
                <munit:attributes value="#[{ headers: { 'x-autoscaler-secret': 'test-secret' } }]"/>
            </munit:set-event>
        </munit:behavior>

        <munit:execution>
            <flow-ref name="autoscale-webhook-flow" doc:name="autoscale-webhook-flow"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('scaled')]" message="Should report a scaling action"/>
            <munit-tools:assert-that expression="#[payload.replicas]" is="#[MunitTools::equalTo(3)]" message="Should have moved to 3 replicas"/>
            <munit-tools:verify-call doc:name="Verify patch called once" processor="http:request" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Patch replicas" attributeName="doc:name"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <!--
      Invoking the flow twice in one test is not a faithful way to simulate a
      redelivery: the first run replaces the message attributes, so the second
      would fail the secret check for reasons unrelated to the cooldown. Instead
      the store is seeded to represent "a scaling action just happened", which is
      exactly the state a repeat alert would arrive in.
    -->
    <munit:test name="e2e-cooldown-suppresses-repeat-alert"
                description="An alert arriving inside an open cooldown window does not scale again">
        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock token" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Request access token" attributeName="doc:name"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{ access_token: 'test-token' }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="Mock get deployment" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Get deployment" attributeName="doc:name"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{ target: { replicas: 2 } }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="Mock patch" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Patch replicas" attributeName="doc:name"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <os:store key="dep-e2e-2" objectStore="Cooldown_Store" doc:name="Seed an open cooldown">
                <os:value>#[now() as String]</os:value>
            </os:store>

            <munit:set-event>
                <munit:payload value="#[{ alert: { id: 'e2e-2', metric: 'cpu', currentValue: 92, resource: { id: 'dep-e2e-2', name: 'orders-api', environment: { id: 'env-1' } }, organization: { id: 'org-1' } } }]"/>
                <munit:attributes value="#[{ headers: { 'x-autoscaler-secret': 'test-secret' } }]"/>
            </munit:set-event>
        </munit:behavior>

        <munit:execution>
            <flow-ref name="autoscale-webhook-flow" doc:name="autoscale-webhook-flow"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('skipped')]" message="Alert inside the cooldown window should be suppressed"/>
            <munit-tools:verify-call doc:name="Verify no patch" processor="http:request" times="0">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Patch replicas" attributeName="doc:name"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <munit:test name="e2e-unauthenticated-call-returns-401"
                description="An unauthenticated call is rejected with 401 and never reaches the platform API">
        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock patch" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Patch replicas" attributeName="doc:name"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <munit:set-event>
